# Copiar como backup.env (chmod 600). No versionar.

# Clave PÚBLICA age (age-keygen -o identidad.txt muestra la pública). La clave privada
# NO debe quedar en el VPS: guárdela fuera del servidor (gestor de contraseñas / bóveda).
BACKUP_AGE_RECIPIENT=age1...

# Destino externo configurado con `rclone config` (S3, Backblaze B2, Google Drive, etc.).
BACKUP_RCLONE_REMOTE=remoto:aphia-backups

BACKUP_RETENTION_DAYS=30
