# Copiar como backup.env (chmod 600). No versionar.

# Clave PÚBLICA age (age-keygen -o identidad.txt muestra la pública). La clave privada
# NO debe quedar en el VPS: guárdela fuera del servidor (gestor de contraseñas / bóveda).
BACKUP_AGE_RECIPIENT=age1...

# Copia local diaria (requisito del cliente): directorio solo accesible por root (700/600).
BACKUP_LOCAL_DIR=/var/backups/aphia
BACKUP_LOCAL_RETENTION_DAYS=14

# Destino externo (opcional pero recomendado: la copia local se pierde con el VPS),
# configurado con `rclone config` (S3, Backblaze B2, Google Drive, etc.).
BACKUP_RCLONE_REMOTE=remoto:aphia-backups
BACKUP_RETENTION_DAYS=30
