# Copiar como infra/production/.env.production en el VPS (chmod 600). No versionar.
# Las contraseñas NO van aquí: están en infra/production/secrets/ (generate-secrets.sh).

# Versión fijada de cloudflared (actualizar de forma controlada).
CLOUDFLARED_VERSION=2026.10.5
# Token del túnel creado en el panel de Cloudflare (Workers VPC → Tunnels).
TUNNEL_TOKEN=

MYSQL_VERSION=8.4
MYSQL_MEMORY_LIMIT=1200m
DB_NAME=aphia
DB_APP_USER=aphia_app
DB_MIGRATOR_USER=aphia_migrator

FILES_MAX_BYTES=10485760
FILES_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
