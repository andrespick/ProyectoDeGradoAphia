# Copiar como infra/production/.env.production en el VPS (chmod 600). No versionar.
# Las contraseñas NO van aquí: están en infra/production/secrets/ (generate-secrets.sh).

# API (FastAPI/Uvicorn). Caddy la expone por HTTPS desde 127.0.0.1:API_PORT.
APP_ENV=production
API_PORT=8000
# Orígenes del frontend permitidos por CORS, separados por coma (sin barra final).
CORS_ORIGINS=https://aphia.example.com
LOG_LEVEL=INFO

MYSQL_VERSION=8.4
MYSQL_MEMORY_LIMIT=1200m
DB_NAME=aphia
DB_APP_USER=aphia_app
DB_MIGRATOR_USER=aphia_migrator

FILES_MAX_BYTES=10485760
FILES_ALLOWED_TYPES=application/pdf,image/png,image/jpeg

# Solo con la API en Cloudflare Workers (perfil "tunnel" del Compose).
# Versión fijada de cloudflared (actualizar de forma controlada) y token del túnel.
CLOUDFLARED_VERSION=2026.10.5
TUNNEL_TOKEN=
