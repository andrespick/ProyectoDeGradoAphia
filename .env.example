# Variables del entorno LOCAL de APHIA. Copie este archivo con: pnpm env:init
# (genera valores aleatorios para los campos vacíos marcados). Nunca versione .env.
# Staging y producción NO usan este archivo: ver docs/despliegue/.

APP_ENV=development

# ── MySQL local (Docker, solo 127.0.0.1) ────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=aphia
DB_USER=aphia_app
DB_PASSWORD=

# ── MySQL de pruebas de integración (contenedor separado, datos en memoria) ─────
TEST_DB_PORT=3308
TEST_DB_ROOT_PASSWORD=
TEST_DB_PASSWORD=

# ── Servicio privado de documentos ──────────────────────────────────────────────
FILES_PORT=4000
# Token entre servicios: mínimo 32 caracteres aleatorios.
FILES_SERVICE_TOKEN=
FILES_MAX_BYTES=10485760
FILES_ALLOWED_TYPES=application/pdf,image/png,image/jpeg

# ── API con Uvicorn (pnpm dev:asgi). Con Workers, estos valores están en wrangler.jsonc
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_MODE=database
# Clave de firma de los tokens de sesión (AUTH_MODE=database): mínimo 32 caracteres (generada).
# pnpm env:init copia el mismo valor a apps/api/.dev.vars para el Worker local.
AUTH_SECRET=
LOG_LEVEL=INFO
